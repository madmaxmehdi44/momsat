# Neon PostgreSQL (keep real credentials only in local .env / deployment secrets)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require&channel_binding=require"
SOURCE_JSON_URL="https://raw.githubusercontent.com/madmaxmehdi44/momsat/main/data/channels.json"

# Neon S3-compatible storage (keep real credentials only in local .env / deployment secrets)
AWS_ENDPOINT_URL_S3="https://YOUR_NEON_STORAGE_ENDPOINT"
AWS_ACCESS_KEY_ID="YOUR_NEON_STORAGE_ACCESS_KEY"
AWS_SECRET_ACCESS_KEY="YOUR_NEON_STORAGE_SECRET"
AWS_REGION="us-east-2"

# Optional encrypted upstream. Leave disabled until authorized AES credentials are available.
SOURCE_ENCRYPTED_ENABLED="false"
SOURCE_ENCRYPTED_URL="https://raw.githubusercontent.com/mytvsat/webservice/main/v2/posts"
SOURCE_AES_KEY_HEX=""
SOURCE_AES_IV_HEX=""

# Official Iran International live channel.
SOURCE_IRANINTL_ENABLED="true"
SOURCE_IRANINTL_LIVE_URL="https://www.iranintl.com/fa/live"
# Optional override for catalog metadata.
SOURCE_IRANINTL_SATELLITE="Hotbird 13E"
SOURCE_IRANINTL_FREQUENCY="11137 MHz"
SOURCE_IRANINTL_POLARIZATION="Horizontal"
SOURCE_IRANINTL_SYMBOL_RATE="27500"
SOURCE_IRANINTL_SERVICE_ID=""
SOURCE_IRANINTL_LOGO_URL=""

# Public directory adapters.
SOURCE_PARSATV_ENABLED="true"
SOURCE_PARSATV_INDEX_URL="https://www.parsatv.com/"
SOURCE_PERSIANTVLIVE_ENABLED="true"
SOURCE_PERSIANTVLIVE_INDEX_URL="https://www.persiantvlive.com/"
SOURCE_PAKHSHZENDE_ENABLED="true"
SOURCE_PAKHSHZENDE_INDEX_URL="https://pakhshzende.com/tv-channels/"

# Generic M3U importer. Provide one or more authorized URLs separated by comma or newline.
SOURCE_M3U_ENABLED="true"
SOURCE_M3U_URLS=""

# Official broadcaster feeds: JSON posts or M3U playlists, comma/newline separated.
SOURCE_OFFICIAL_ENABLED="true"
SOURCE_OFFICIAL_URLS=""

# Discovery controls.
SOURCE_SITE_MAX_CHANNELS="250"
SOURCE_SITE_CONCURRENCY="6"
SOURCE_FETCH_TIMEOUT_MS="15000"
SOURCE_HTTP_USER_AGENT="MomSatCatalog/1.0"
SOURCE_WEB_FETCH_TIMEOUT_MS="12000"
SOURCE_WEB_DISCOVERY_MAX_DEPTH="3"
SOURCE_WEB_DISCOVERY_MAX_PAGES="18"

# XMLTV EPG. Provide one or more authorized XMLTV URLs separated by comma or newline.
EPG_XMLTV_URLS=""
EPG_FETCH_TIMEOUT_MS="20000"
EPG_HORIZON_DAYS="7"

# Admin API secret. Never commit the real value.
ADMIN_TOKEN="change-me"
