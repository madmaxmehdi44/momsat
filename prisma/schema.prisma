generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
model Category { id Int @id; name String; nameEn String; channels Channel[] }
model Channel { id Int @id; name String; nameEn String; image String?; url String; referer String?; origin String?; vpn Boolean @default(false); iran Boolean @default(false); popular BigInt @default(0); vip Boolean @default(false); categoryId Int; categoryName String?; categoryNameEn String?; category Category @relation(fields:[categoryId], references:[id]); sources Source[]; updatedAt DateTime @updatedAt; createdAt DateTime @default(now()); @@index([categoryId]); @@index([name]); }
model Source { id Int @id; channelId Int; title String?; url String; referer String?; origin String?; country String?; vip Boolean @default(false); channel Channel @relation(fields:[channelId], references:[id], onDelete:Cascade); @@index([channelId]) }