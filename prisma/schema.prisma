generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ChannelArchiveStatus {
  MEMORY
  SHUTDOWN
}

enum StreamHealthStatus {
  UNKNOWN
  HEALTHY
  SUSPECT
  BROKEN
  ARCHIVED
}

model Category {
  id       Int       @id
  name     String
  nameEn   String
  channels Channel[]
}

model Channel {
  id              Int       @id
  name            String
  nameEn          String
  catalogKey      String?   @unique
  image           String?
  url             String
  referer         String?
  origin          String?
  vpn             Boolean   @default(false)
  iran            Boolean   @default(false)
  popular         BigInt    @default(0)
  vip             Boolean   @default(false)
  language        String?
  country         String?
  platform        String?
  satellite       String?
  frequency       String?
  polarization    String?
  symbolRate      String?
  serviceId       String?
  categoryId      Int
  categoryName    String?
  categoryNameEn  String?
  archiveStatus   ChannelArchiveStatus?
  archiveNote     String?
  archiveSince    DateTime?
  category        Category  @relation(fields: [categoryId], references: [id])
  sources         Source[]
  programs        Program[]
  streamHealth    StreamHealth[]
  updatedAt       DateTime  @updatedAt
  createdAt       DateTime  @default(now())

  @@index([categoryId])
  @@index([name])
  @@index([nameEn])
  @@index([platform])
  @@index([archiveStatus])
  @@index([archiveStatus, archiveSince])
}

model Source {
  id        Int     @id
  channelId Int
  title     String?
  url       String
  referer   String?
  origin    String?
  country   String?
  vip       Boolean @default(false)
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@index([url])
}

model StreamHealth {
  id                  Int                @id @default(autoincrement())
  channelId           Int
  url                 String
  status              StreamHealthStatus  @default(UNKNOWN)
  successCount        Int                @default(0)
  failureCount        Int                @default(0)
  failureStreak       Int                @default(0)
  lastCheckedAt       DateTime?
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  lastLatencyMs       Int?
  averageLatencyMs    Int?
  lastError           String?
  disabledAt          DateTime?
  disabledReason      String?
  updatedAt           DateTime           @updatedAt
  createdAt           DateTime           @default(now())
  channel             Channel            @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, url])
  @@index([status, failureStreak])
  @@index([channelId, status])
  @@index([lastFailureAt])
}

model EpgChannel {
  id            String    @id
  displayName   String
  displayNameEn String?
  icon          String?
  url           String?
  programs      Program[]
  updatedAt     DateTime  @updatedAt
  createdAt     DateTime  @default(now())

  @@index([displayName])
}

model Program {
  id           String      @id
  channelId    Int?
  epgChannelId String
  title        String
  subTitle     String?
  description  String?
  category     String?
  icon         String?
  start        DateTime
  end          DateTime
  channel      Channel?    @relation(fields: [channelId], references: [id], onDelete: SetNull)
  epgChannel   EpgChannel  @relation(fields: [epgChannelId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([channelId, start, end])
  @@index([epgChannelId, start, end])
  @@index([start, end])
}
