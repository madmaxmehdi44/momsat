{
  "name": "momsat-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/harden-live-player.mjs && next dev --turbopack",
    "build": "node scripts/harden-live-player.mjs && prisma generate && next build",
    "start": "node scripts/harden-live-player.mjs && next start",
    "lint": "node scripts/harden-live-player.mjs && prisma generate && tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:verify": "tsx scripts/verify-prisma.ts",
    "seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate && node scripts/harden-live-player.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "hls.js": "^1.6.13",
    "lucide-react": "^0.468.0",
    "next": "^16.3.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "prisma": "^6.15.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
